{
  "name": "@internal/registry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The workflow registry service: register, promote, retire and resolve compiled workflow versions.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@internal/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@internal/core": "workspace:*",
    "@internal/workflow": "workspace:*"
  },
  "devDependencies": {
    "@internal/config": "workspace:*",
    "@internal/testing": "workspace:*",
    "vitest": "5.0.1"
  }
}
