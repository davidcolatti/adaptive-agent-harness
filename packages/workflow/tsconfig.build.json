{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Build configuration: emits dist/ and deliberately does NOT enable the
  // "@internal/source" condition, so a package compiles against its
  // dependencies' built .d.ts files. That is why turbo's `build` task depends
  // on `^build`.
  "extends": "@internal/config/tsconfig.package.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"],
  // `*.test-fixtures.ts` and `test-fixtures.ts` hold values several test files
  // share. They are ordinary modules rather than `*.test.ts` ones, so importing
  // them does not re-run another file's suite, and they are excluded here so
  // test-only code and its `@internal/testing` devDependency never reach
  // `dist/`. `tsconfig.json` still typechecks them.
  "exclude": ["src/**/*.test.ts", "src/**/test-fixtures.ts"]
}
