{
  "name": "@internal/runtime-eve",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The eve agent-runtime adapter: EveAgentRuntime, plus a test helper that starts an eve dev server.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@internal/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@internal/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@internal/core": "workspace:*",
    "ai": "7.0.107",
    "eve": "0.63.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@internal/config": "workspace:*",
    "@internal/testing": "workspace:*",
    "vitest": "5.0.1"
  }
}
