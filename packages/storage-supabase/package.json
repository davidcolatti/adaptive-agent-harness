{
  "name": "@internal/storage-supabase",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Supabase storage adapter: createSupabaseStorage() implements the Storage port (M2-T5, M2-T7), plus the generated database types (M2-T11).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@internal/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@internal/core": "workspace:*",
    "@internal/trace": "workspace:*",
    "@supabase/supabase-js": "2.116.0"
  },
  "devDependencies": {
    "@internal/config": "workspace:*",
    "@internal/testing": "workspace:*",
    "vitest": "5.0.1"
  }
}
